{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DNS Switcher Profiles Configuration",
  "description": "Schema for Antigravity / Windows 11 DoH DNS switcher profiles, deprecated/blocked resolvers, and test domains.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "environment_notes",
    "deprecated_or_blocked",
    "test_domains",
    "profiles"
  ],
  "additionalProperties": false,
  "definitions": {
    "ipv4": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^((25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$"
    },
    "domain": {
      "type": "string",
      "format": "hostname",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$"
    },
    "domain_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/domain"
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "environment_notes": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_or_blocked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ip",
          "provider",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ip": {
            "$ref": "#/definitions/ipv4"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_domains": {
      "type": "object",
      "required": [
        "antigravity_core",
        "google_auth",
        "ai_inference",
        "ecosystem"
      ],
      "additionalProperties": false,
      "properties": {
        "antigravity_core": {
          "$ref": "#/definitions/domain_list"
        },
        "google_auth": {
          "$ref": "#/definitions/domain_list"
        },
        "ai_inference": {
          "$ref": "#/definitions/domain_list"
        },
        "ecosystem": {
          "$ref": "#/definitions/domain_list"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "recommended_for",
          "ipv4",
          "doh_template",
          "doh_ips",
          "dot_host",
          "requires_http2",
          "default_allow_udp_fallback",
          "auto_upgrade_doh",
          "smart_proxy_domains",
          "trust_note",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "vpn-clean",
              "rf-smart",
              "rf-clean"
            ]
          },
          "recommended_for": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "vpn-on",
                "vpn-off"
              ]
            }
          },
          "ipv4": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/ipv4"
            }
          },
          "doh_template": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s/]+/.*"
          },
          "doh_ips": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/ipv4"
            }
          },
          "dot_host": {
            "$ref": "#/definitions/domain"
          },
          "requires_http2": {
            "type": "boolean"
          },
          "default_allow_udp_fallback": {
            "type": "boolean"
          },
          "auto_upgrade_doh": {
            "type": "boolean"
          },
          "smart_proxy_domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/domain"
            }
          },
          "trust_note": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
